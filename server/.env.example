# ---- Server ----
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# ---- MongoDB ----
# REQUIRED. Never commit real credentials. Atlas example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/contractor_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/contractor_management
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_RETRIES=3
MONGODB_RETRY_DELAY_MS=2000

# ---- Logging ----
# error | warn | info | http | debug   (default: debug in development, info otherwise)
LOG_LEVEL=debug
# Set to true to also write JSON logs to LOG_DIR (always JSON on console in production)
LOG_TO_FILE=false
LOG_DIR=logs
